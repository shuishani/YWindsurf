{
  "name": "ywindsurf",
  "version": "3.0.0",
  "description": "YWindsurf 账号管理工具 - 批量注册、自动切换、账号池管理",
  "main": "src/main/index.js",
  "scripts": {
    "start": "powershell -Command \"[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; electron-forge start\"",
    "start:prod": "powershell -Command \"[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; $env:NODE_ENV='production'; electron .\"",
    "dev": "powershell -Command \"[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; electron . --dev\"",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "build:win": "electron-builder --win",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "keywords": [
    "windsurf",
    "account",
    "switcher"
  ],
  "author": "YWindsurf Team",
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^9.2.2",
    "chrome-launcher": "^1.2.1",
    "electron-squirrel-startup": "^1.0.1",
    "imap": "^0.8.19",
    "mailparser": "^3.6.5",
    "puppeteer-real-browser": "^1.3.10",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "asar": "^3.2.0",
    "asarmor": "^3.0.2",
    "electron": "^27.1.0",
    "electron-builder": "^26.0.12",
    "javascript-obfuscator": "^5.1.0",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "com.ywindsurf.tool",
    "productName": "YWindsurf",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.{md,markdown,map}",
      "!**/test/**",
      "!**/tests/**",
      "!**/docs/**",
      "!**/example/**",
      "!**/examples/**",
      "!**/.git/**",
      "!node_modules/**/src/**/*.c",
      "!node_modules/**/src/**/*.h",
      "!node_modules/**/src/**/*.cpp",
      "!node_modules/**/deps/**",
      "!node_modules/**/build/**/*.iobj",
      "!node_modules/**/build/**/*.ipdb",
      "!node_modules/**/build/**/*.lib",
      "!node_modules/**/build/**/*.tlog",
      "!node_modules/**/build/**/*.c",
      "!node_modules/**/build/**/*.h"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "asar": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "LICENSE.txt",
      "artifactName": "YWindsurf-Setup.exe",
      "unicode": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
